// ─── Floating WhatsApp Button ────────────────────────────────────────────────
function FloatingWhatsApp() {
  const [visible, setVisible] = useState(false);

  useEffect(() => {
    const timer = setTimeout(() => setVisible(true), 2000);
    return () => clearTimeout(timer);
  }, []);

  return (
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      className={`fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-[#25D366] hover:bg-[#128C7E] text-white pl-5 pr-6 py-3.5 rounded-full shadow-2xl shadow-green-900/30 transition-all duration-500 active:scale-[0.93] ${
        visible ? "translate-y-0 opacity-100" : "translate-y-8 opacity-0"
      }`}
      aria-label="Contactar por WhatsApp"
    >
      <WhatsAppIcon className="w-6 h-6" />
      <span className="font-medium text-sm hidden sm:inline">¿Necesitás un turno?</span>
    </a>
  );
}

