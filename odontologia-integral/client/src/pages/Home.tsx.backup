// ─── Why Us Section ──────────────────────────────────────────────────────────
const reasons = [
  {
    icon: <Users className="w-6 h-6" />,
    title: "Trato humano y cercano",
    description:
      "Te escuchamos, te explicamos y te acompañamos en cada paso de tu tratamiento.",
  },
  {
    icon: <Shield className="w-6 h-6" />,
